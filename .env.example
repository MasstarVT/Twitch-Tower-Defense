# Twitch channel to listen to (no #). Required.
TWITCH_CHANNEL=yourchannel

# Optional: bot account for replying in chat (!coins, !shop etc).
# Get a token at https://twitchtokengenerator.com (scopes: chat:read chat:edit).
# Leave blank to run read-only; replies then show as overlay toasts only.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH=

# HTTP + WebSocket port
PORT=3000
